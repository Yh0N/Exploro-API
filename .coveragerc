[run]
source = app
branch = True
omit =
    app/services/linear_regression.py
    app/services/collaborative_filter.py
    app/services/sentiment_analysis.py
    app/services/oauth_service.py
    app/services/geocoding_service.py
    app/services/image_service.py
    app/routes/image_routes.py
    app/api/*

[report]
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError
